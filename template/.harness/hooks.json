{
  "hooks": [
    {
      "event": "before-command",
      "handlers": [
        {
          "script": "scripts/hooks/guard-git.mjs",
          "timeout": 15,
          "statusMessage": "Checking the command against the worktree rules"
        },
        {
          "script": "scripts/hooks/guard-unprovisioned-worktree.mjs",
          "timeout": 15,
          "statusMessage": "Checking the worktree has been set up"
        }
      ]
    },
    {
      "event": "before-edit",
      "handlers": [
        {
          "script": "scripts/hooks/block-generated-edit.mjs",
          "timeout": 15,
          "statusMessage": "Checking the target is not generated output"
        },
        {
          "script": "scripts/hooks/guard-delivery.mjs",
          "timeout": 15,
          "statusMessage": "Checking the edit against protected tests and design approval"
        }
      ]
    }
  ]
}
